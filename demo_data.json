      "id": "mito",
      "label": "Mito-Transformation",
      "parentId": null,
      "order": 1,
      "icon": "⚗️",
      "desc": "Transport exogener DNA in pflanzliche Mitochondrien, Nachweis via RNA-Editing.",
      "custom": [
        {
          "id": "sec_exp_mito",
          "title": "Experiment / Method",
          "content": "Co-Transformation pDC097 + DNA-Cargo → RT-PCR mit C→U RNA-Editing an nad9."
        },
        {
          "id": "sec_dr_mito",
          "title": "Design Rationale",
          "content": "RepA bindet ssDNA kovalent via Tyr. Nach TEV-Schnitt zieht mtPre das Komplex ins Mito. DNA-Cargo als Invertiertes Repeat mit Nonanukleotid. nad9-Arme für Integration."
        },
        {
          "id": "sec_next_mito",
          "title": "Next Steps",
          "content": "Sauberen Nachweis erbringen (pos. + neg. Kontrolle in einem Versuch)."
        }
      ]
